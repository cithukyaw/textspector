# Server-side Secret (used by Vercel Serverless Function /api/detect and Express proxy)
# Configure this in Vercel Project Settings > Environment Variables
OPENROUTER_API_KEY=

# Provider Configuration: "openrouter" (default) or "ollama"
VITE_PROVIDER=openrouter

# OpenRouter Model Settings (Public configuration)
VITE_OPENROUTER_DEFAULT_MODEL=nvidia/nemotron-3-ultra:free
# Comma-separated list of models to prioritize for OpenRouter fallback/routing (optional)
VITE_OPENROUTER_MODELS=

# Ollama Settings (Optional, for local models)
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_DEFAULT_MODEL=qwen3:7b
# Comma-separated list of models to populate in Ollama UI selector (optional)
VITE_OLLAMA_MODELS=

# GEMINI_API_KEY: Optional
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted
APP_URL=
