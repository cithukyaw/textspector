# Server-side Secret (used by Vercel Serverless Function /api/detect and Express proxy)
# Configure this in Vercel Project Settings > Environment Variables
OPENROUTER_API_KEY=

# Provider Configuration: "openrouter" (default) or "ollama"
VITE_PROVIDER=openrouter

# OpenRouter Model Settings (Public configuration)
VITE_OPENROUTER_DEFAULT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Comma-separated list of models to prioritize for OpenRouter fallback/routing
VITE_OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,openrouter/free

# Ollama Settings (Optional, for local models)
VITE_OLLAMA_BASE_URL=http://localhost:11434
VITE_OLLAMA_DEFAULT_MODEL=qwen2.5:7b
# Comma-separated model list for the Ollama UI selector
VITE_OLLAMA_MODELS=qwen3:1.7b,qwen2.5:7b,qwen2.5:14b,llama3.2:latest,deepseek-r1:14b,mistral

# APP_URL: The URL where this applet is hosted
APP_URL=
